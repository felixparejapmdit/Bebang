rules_version = '2';

// Bebang BMS — Firestore Security Rules (approval-based access).
// Publish: Firebase Console → Firestore Database → Rules → paste this file → Publish,
//      or: firebase deploy --only firestore:rules
//
//   business/main   the shared business data — approved users and admins only
//   users/{uid}     one access record per signed-in account (pending/approved/rejected/revoked)
//   invites/{email} emails the admin pre-approved (let in on first sign-in, with a role)
//   config/access   roles & permissions (Settings → Roles / Access Matrix) — owner writes, approved users read
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }

    // Keep in sync with ADMIN_EMAILS in js/config/firebase-config.js.
    function isAdmin() {
      return signedIn() && verified() && myEmail() in ['felixpareja.pmdit07@gmail.com'];
    }
    function myRecord() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isApproved() {
      return isAdmin() || (signedIn() && exists(myRecord()) && get(myRecord()).data.status == 'approved');
    }
    function inviteDoc() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function invited() {
      return signedIn() && verified() && exists(inviteDoc());
    }
    // People approved before roles existed have no roleId: they keep the Manager role.
    function myRoleId() { return get(myRecord()).data.get('roleId', 'manager'); }
    function accessConfig() { return /databases/$(database)/documents/config/access; }
    // Roles whose permissions are all "view" are saved with readOnly: true — they may not write.
    function roleIsReadOnly() {
      return exists(accessConfig())
        && get(accessConfig()).data.roles.get(myRoleId(), {}).get('readOnly', false) == true;
    }

    match /business/main {
      allow read: if isApproved();
      allow write: if isAdmin() || (isApproved() && !roleIsReadOnly());
    }

    match /config/access {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // First sign-in: you may only create YOUR OWN record, as a pending "user"
      // (or already approved if the admin pre-approved your verified email).
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && invited()))
        // no role unless it's the one the owner put on your invitation
        && (!('roleId' in request.resource.data)
            || (invited() && request.resource.data.roleId == get(inviteDoc()).data.get('roleId', null)))
      );
      // You may refresh your own profile/last-seen, but never change your own status or role —
      // except asking again after a decline (rejected → pending). The admin can change anything.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        // only profile / last-seen / request fields — never your own role
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'provider', 'lastSeenAt', 'status', 'requestedAt', 'note'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'rejected' && request.resource.data.status == 'pending'))
      );
      allow delete: if isAdmin();
    }

    match /invites/{inviteEmail} {
      allow get: if isAdmin() || (signedIn() && myEmail() == inviteEmail);
      allow list, create, update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
